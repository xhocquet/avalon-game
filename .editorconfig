root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
csharp_new_line_before_open_brace = none
dotnet_diagnostic.IDE0130.severity = none
dotnet_separate_import_directive_groups = false
dotnet_sort_system_directives_first = true
dotnet_style_namespace_match_folder = false
resharper_check_namespace_highlighting = none
resharper_csharp_empty_block_style = together_same_line
# `just format` (ReSharper) and the pre-commit hook (dotnet format) both touch sim/, and
# they disagreed on nested loop bodies: Roslyn always indents them, ReSharper defaults to
# leaving consecutive for/foreach un-indented, so each tool reverted the other. Roslyn has
# no knob for this, so ReSharper is the side that moves.
resharper_indent_nested_fixed_stmt = true
resharper_indent_nested_for_stmt = true
resharper_indent_nested_foreach_stmt = true
resharper_indent_nested_lock_stmt = true
resharper_indent_nested_usings_stmt = true
resharper_indent_nested_while_stmt = true

# Constants are PascalCase, not SCREAMING_CASE. ReSharper's `AaBb` is a literal pattern, so
# it rejects the underscore; the Roslyn equivalent does not (its pascal_case treats `_` as a
# word separator, so SOME_VALUE passes). IDE/inspectcode only — `just format` runs the
# reformat-only profile and applies no naming rules.
resharper_csharp_naming_rule.constants = AaBb
resharper_csharp_naming_rule.private_constants = AaBb
resharper_csharp_naming_rule.local_constants = AaBb

[*.md]
trim_trailing_whitespace = false
