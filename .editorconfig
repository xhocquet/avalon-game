root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
csharp_new_line_before_open_brace = none
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
resharper_csharp_empty_block_style = together_same_line

# This project uses a flat `Meesles.Avalon` namespace regardless of folder depth, but
# <RootNamespace> is `Meesles.Avalon.Client`, so the folder-match inspections keep trying to
# rewrite files to `Meesles.Avalon.Client.Scripts.View` and churn cross-namespace usings. Turn the
# folder-matching off so the flat convention is accepted.
dotnet_style_namespace_match_folder = false
dotnet_diagnostic.IDE0130.severity = none
resharper_check_namespace_highlighting = none

[*.md]
trim_trailing_whitespace = false
