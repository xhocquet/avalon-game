# Editor / IDE
.idea/
.vscode/
.vs/
*.user
*.suo

# Server build outputs and runtime logs
server/bin/
server/obj/
**/*.meta

# Logs
server/Logs/*
!server/Logs/.keep
/Logs/*
!/Logs/.keep

# Test outputs
TestResults/
tests/**/bin/
tests/**/obj/

# Tool build outputs
tools/**/bin/
tools/**/obj/

# Local scratch space (also holds deploy publish/dist output)
.tmp/

# Deploy config — hosts, users, key paths
.env
.env.local

# Baked into exported clients only; a working copy must fall back to localhost
client/server_endpoint.json

# Klotho analyzer/editor snapshots. Builds use analyzer output from obj/.
sim/Tools/Generated/
client/Sim/Tools/Generated/

# Godot uid stubs outside the Godot project root (client/)
*.uid
!client/**/*.uid

# Lore
.lore/
