# ====================================================================
# Global & Root Level Ignores
# ====================================================================

# Version Control Internals
.git/

# Editor / IDE
.idea/
.vscode/
.vs/
*.user
*.suo

# Logs
/Logs/*
!/Logs/.keep

# Local scratch space
.tmp/

# Lore Internal Directory (Always ignore this)
.lore/

# ====================================================================
# Server & Test Components
# ====================================================================

# Server build outputs and runtime logs
server/bin/
server/obj/
**/*.meta

# Server Logs
server/Logs/*
!server/Logs/.keep

# Test & Tool outputs
TestResults/
tests/**/bin/
tests/**/obj/
tools/**/bin/
tools/**/obj/

# Klotho analyzer/editor snapshots
sim/Tools/Generated/
client/Sim/Tools/Generated/

# ====================================================================
# Client Components (Godot & Mono)
# ====================================================================

# Godot 4.2+ specific ignores
client/~*.dll

# Godot 4+ specific ignores
client/.godot/
client/.nomedia

# Godot-specific ignores
client/.import/
client/export.cfg
client/export_credentials.cfg
client/*.tmp

# Imported translations (automatically generated from CSV files)
client/*.translation

# Mono-specific ignores
client/.mono/
client/data_*/
client/mono_crash.*.json
client/logs/

# ====================================================================
# Vendor / Klotho Submodule Components
# ====================================================================

**/obj/Debug/**
**/bin/Debug/**

# Catch hidden folders with tildes (e.g., Godot~/obj/, Server~/obj/)
vendor/klotho/**/*~/obj/
vendor/klotho/**/*~/bin/
vendor/klotho/**/*~/Packaging/

# OS & Environment Files
vendor/klotho/**/.DS_Store
vendor/klotho/**/.idea
vendor/klotho/**/.vsconfig
vendor/klotho/**/*.pem
vendor/klotho/**/*.p12

# IDEs & Editor Tooling Configs
vendor/klotho/**/.vscode/
vendor/klotho/**/.vs/
vendor/klotho/**/.config/
vendor/klotho/**/.cursor/
vendor/klotho/**/.claude/
vendor/klotho/**/.vsconfig/
vendor/klotho/**/.godot/

# Internal Project Docs
vendor/klotho**/Docs/IMP/
vendor/klotho**/Docs/REF/

# Build & System Outputs
vendor/klotho**/Generated/
vendor/klotho**/Output/
vendor/klotho**/Replays/
vendor/klotho**/MemoryCaptures/

# Engine / Project Cache and Artifacts
vendor/klotho/**/[Aa]ssets/[Pp]ackages/
vendor/klotho/**/Library/
vendor/klotho/**/Logs/
vendor/klotho/**/Temp/
vendor/klotho/**/UserSettings/

# Compiled Binaries & Intermediates (Fallback)
vendor/klotho**/obj/
vendor/klotho**/bin/
vendor/klotho**/Binaries/
vendor/klotho**/Intermediate/
vendor/klotho**/IncrementalBuildPipeline/
vendor/klotho**/BUILD/
vendor/klotho**/*.app/
vendor/klotho**/*_BackUpThisFolder_*/
vendor/klotho**/*_BurstDebugInformation_*/

# IDE Projects & Solutions (Klotho)
vendor/klotho**/.DS_Store**/Klotho/*.csproj
vendor/klotho**/Klotho/*.sln
vendor/klotho**/Klotho/*.slnx

# IDE Projects & Solutions (Samples & Unity)
vendor/klotho**/P2pSample/*.csproj
vendor/klotho**/P2pSample/*.sln
vendor/klotho**/P2pSample/*.slnx

vendor/klotho**/SdSample/*.csproj
vendor/klotho**/SdSample/*.sln
vendor/klotho**/SdSample/*.slnx

vendor/klotho**/Unity2022/*.csproj
vendor/klotho**/Unity2022/*.sln
vendor/klotho**/Unity2022/*.slnx

# Godot Presets
vendor/klotho**/export_presets.cfg



# Blender automatic backup files
*.blend1
*.blend2
*.blend3
*.blend?


# Windows thumbnail & indexing caches
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS system files (if you ever share with Mac users)
.DS_Store
.AppleDouble
.LSOverride


# .NET / NuGet local tracking files
.nuget/
*.nuget.props
*.nuget.targets

# MSBuild structured logs
*.binlog


# Additional modern editor caches
.zed/
.helix/
*.swp

*.cs.meta
